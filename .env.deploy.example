COMPOSE_PROJECT_NAME=agentproject8gb
DEPLOY_BIND=127.0.0.1
DEPLOY_PORT=8080
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=example-not-a-real-key
LLM_MODEL=example-model
LLM_MAX_RETRIES=4
DEEPSEEK_API_KEY=example-not-a-real-key
DEPLOY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
MINIO_ROOT_USER=deployment-local
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Immutable Hugging Face commit verified through the official model API.
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
# Used only when provisioning the pinned embedding model.
HF_ENDPOINT=https://huggingface.co
RAG_COLLECTION=energy_bge_small_zh_v15
HITL_ENABLED=on
